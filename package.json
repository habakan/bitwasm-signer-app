{
  "name": "bitwasm-signer-app",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "engine:web": "cargo build --release --target wasm32-unknown-unknown --manifest-path web/engine/Cargo.toml",
    "dev:web": "pnpm engine:web && vite --mode web",
    "build:web": "pnpm engine:web && tsc && vite build --mode web --outDir dist-web",
    "build:pwa": "pnpm engine:web && tsc && vite build --mode pwa --outDir dist-web/app",
    "dev:installer": "vite installer",
    "build:installer": "tsc -p installer && vite build installer",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tokens": "node scripts/design-tokens.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/android-bin": "2.1.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitepress": "1.6.4"
  }
}
